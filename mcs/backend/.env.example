# WattWise MCS — environment variables.
# Local development: copy to `.env` and start uvicorn with
#   uvicorn app.main:app --reload --port 8001 --env-file .env
# Deployment: set the same values in Render's Environment page.

# Postgres connection (Supabase). Use the Transaction pooler (port 6543) and
# the +psycopg driver suffix:
#   postgresql+psycopg://postgres.<project-ref>:<password>@aws-0....pooler.supabase.com:6543/postgres?sslmode=require
# Leave unset for local dev (defaults to mcs/backend/wattwise.db SQLite).
MCS_DATABASE_URL=

# Admin console login. SET A STRONG PASSWORD before deploying.
MCS_ADMIN_USERNAME=admin
MCS_ADMIN_PASSWORD=change-me

# Signs session cookies. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Render can generate this automatically (render.yaml uses generateValue).
MCS_SESSION_SECRET=change-me-to-a-long-random-string

# Must be "true" (lowercase) behind HTTPS — Render/Supabase terminate TLS.
MCS_SECURE_COOKIES=true

# PHP per kWh used for estimated bills.
MCS_ELECTRICITY_RATE=12

# OAuth client credentials (obtain from Google Cloud Console / GitHub Developer Settings)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Frontend URL for OAuth redirect after sign-in
MCS_FRONTEND_URL=http://localhost:5174
